# =========================================================
# APPLICATION
# =========================================================

APP_NAME=optimizer-backend
APP_HOST=0.0.0.0
APP_PORT=8000

# =========================================================
# DATABASE
# =========================================================

# Local execution outside Compose: `localhost`.
# End-to-end tests with real infrastructure: RUN_E2E_INTEGRATION=1
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=optimizer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=

# =========================================================
# RABBITMQ
# =========================================================

# Docker Compose: `rabbitmq`. Outside Compose: `localhost`.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_OPTIMIZATION=optimization
# AMQP heartbeat in seconds. Optimization jobs may take several minutes.
RABBITMQ_HEARTBEAT=600

# Async queue: `false` uses RabbitMQ; `true` uses the in-memory test queue.
ASYNC_QUEUE_USE_MOCK=false

# =========================================================
# MINIO
# =========================================================

# Docker Compose: `minio:9000`. Outside Compose: `localhost:9000`.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=optimizer
MINIO_SECURE=false
# Public host URL for downloads and audit access.
MINIO_PUBLIC_BASE_URL=http://localhost:9000
MINIO_ROOT_PREFIX=ingestion

# =========================================================
# OPTIMIZER (worker)
# =========================================================

# Docker Compose mounts the optimizer at /optimizer.
# Local execution accepts an absolute path or a path relative to apps/backend.
ALGORITHM_ROOT=/optimizer

# =========================================================
# CORS (frontend integration)
# =========================================================

# Allowed origins, separated by commas.
# Next.js local: http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
